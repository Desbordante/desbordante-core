{
    "version": 6,
    "configurePresets": [
        {
            "name": "common",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ubsan",
            "displayName": "Undefined Behavior Sanitizer",
            "inherits": "debug",
            "cacheVariables": {
                "DESBORDANTE_SANITIZER": "UB"
            }
        },
        {
            "name": "asan",
            "displayName": "Address Sanitizer",
            "inherits": "debug",
            "cacheVariables": {
                "DESBORDANTE_SANITIZER": "ADDRESS",
                "CMAKE_CXX_FLAGS_DEBUG": "-O1"
            }
        },
        {
            "name": "benchmark",
            "displayName": "Benchmarks",
            "inherits": "release",
            "cacheVariables": {
                "DESBORDANTE_BUILD_BENCHMARKS": "ON",
                "DESBORDANTE_BUILD_TESTS": "OFF"
            }
        },
        {
            "name": "tidyexts",
            "inherits": "debug",
            "cacheVariables": {
                "DESBORDANTE_FETCH_DATASETS": "OFF",
                "DESBORDANTE_BUILD_TIDYEXTS": "ON"
            }
        },
        {
            "name": "compilecommands",
            "inherits": "debug",
            "cacheVariables": {
                "DESBORDANTE_BUILD_TIDYEXTS": "ON",
                "DESBORDANTE_BINDINGS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "DESBORDANTE_BUILD_BENCHMARKS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "displayName": "Debug build"
        },
        {
            "name": "release",
            "configurePreset": "release",
            "displayName": "Release build"
        },
        {
            "name": "ubsan",
            "configurePreset": "ubsan",
            "displayName": "Undefined Behavior Sanitizer build"
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "displayName": "Address Sanitizer build"
        },
        {
            "name": "benchmark",
            "configurePreset": "benchmark",
            "displayName": "Benchmarks build"
        },
        {
            "name": "tidyexts",
            "configurePreset": "tidyexts",
            "targets": ["Desbordante.tidyexts"]
        }

    ],
    "testPresets": [
        {
            "name": "common",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "light",
            "hidden": true,
            "inherits": "common",
            "filter": {
                "exclude": {
                    "name": ".*HeavyDatasets.*"
                }
            }
        },
        {
            "name": "debug",
            "displayName": "Test debug build excluding heavy tests",
            "configurePreset": "debug",
            "inherits": "light"
        },
        {
            "name": "release",
            "displayName": "Test release build excluding heavy tests",
            "configurePreset": "release",
            "inherits": "light"
        },
        {
            "name": "release-all",
            "displayName": "Test release build with heavy tests (might be very slow)",
            "configurePreset": "release",
            "inherits": "common"
        },
        {
            "name": "ubsan",
            "displayName": "Test UBSan build excluding heavy tests",
            "configurePreset": "ubsan",
            "inherits": "light"
        },
        {
            "name": "asan",
            "displayName": "Test ASan build excluding heavy tests",
            "configurePreset": "asan",
            "inherits": "light"
        }
    ],
    "workflowPresets": [
        {
            "name": "tidyexts",
            "steps": [
                { "name": "tidyexts", "type": "configure" },
                { "name": "tidyexts", "type": "build" }
            ]
        },
        {
            "name": "compilecommands",
            "steps": [
                { "type": "configure", "name": "compilecommands" }
            ]
        }
    ]
}
