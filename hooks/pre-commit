#!/bin/sh

SOURCE_FILES=$(git diff --cached --name-only --diff-filter=M -- "*.cpp" "*.h" "*.hpp")

if [[ -n "$SOURCE_FILES" ]]; then
    cmake --workflow --preset tidyexts
    cmake --preset debug

    TIDYEXTS_PATH=$(find ./build/tidyexts -name "libDesbordante.tidyexts*")

    echo Using tidyexts at $TIDYEXTS_PATH
    echo Running checks for changed files: $SOURCE_FILES

    set -euo pipefail
    echo "Clang-tidy"
    clang-tidy -p=./build/debug --config-file=.clang-tidy -load=${TIDYEXTS_PATH} $SOURCE_FILES
    echo "Clang-format"
    clang-format --dry-run -Werror --style=file:.clang-format -i $SOURCE_FILES
fi